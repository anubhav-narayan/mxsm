// Root rule: The top-level structure of the ISDL file
start: comment_block* import_block* architecture_block? format_block* instruction_block* alias_block*

// Comment Blocks
comment_block: single_line_comment | multi_line_comment

// Single-line comment starts with '#'
single_line_comment: "#" /[^\n]*/  

// Multi-line comment starts with '/*' and ends with '*/'
multi_line_comment: "/*" /[^*]*\*+([^/*][^*]*\*+)*"/  

// Import Statements: Handle importing other ISDL files or items from files
import_block: "import" CNAME
from_import_block: "from" CNAME "import" item_list

// List of items to import (comma-separated)
item_list: CNAME ("," CNAME)*

// Architecture Block (as a flexible dictionary)
architecture_block: "architecture" CNAME "is" dict

// Format Block (as a flexible dictionary)
format_block: "format" CNAME "is" dict

// Instruction Block (as a flexible dictionary)
instruction_block: "instruction" CNAME "is" dict

// Alias Block: Create an alias for an existing instruction or operation
alias_block: "alias" CNAME "is" CNAME operand_list

// Operand list: A comma-separated list of operands
operand_list: operand ("," operand)*
operand: CNAME

// Flexible dictionary-like structure (can be used for architecture, format, instruction blocks)
dict: "{" dict_item* "}"

dict_item: key ":" value

// Key can be either a CNAME (identifier) or a STRING (quoted text)
key: CNAME | STRING  

// Value can be a number, another dictionary (nested), or a string (quoted text)
value: number | dict | STRING  

// Numbers with radices: Binary, Octal, Decimal, or Hexadecimal
number: hex_number | bin_number | oct_number | dec_number

// Hexadecimal numbers (e.g., 0x1A)
hex_number: "0x" /[0-9A-Fa-f]+/

// Binary numbers (e.g., 0b1101)
bin_number: "0b" /[01]+/

// Octal numbers (e.g., 0o17)
oct_number: "0o" /[0-7]+/

// Decimal numbers (e.g., 123)
dec_number: /[0-9]+/

// String: Quoted text (e.g., "myString")
STRING: /"[^"]*"/

// Identifiers: Valid names for instructions, registers, etc.
CNAME: /[a-zA-Z_][a-zA-Z0-9_]*/
