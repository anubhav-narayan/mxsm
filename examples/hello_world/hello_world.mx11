; Programme write "Hello World!" to location 0x80
; Architectue: MX11SU
; Programmer: Anubhav Mattoo

.data
; Data Segment of the Programme
        .byte &main
        .byte &loop
        .byte 128               ; Destination Address
        .byte 12                ; String Length
        .byte "Hello World!"    ; String


.ins
; Instruction Segment of the Programme
main:   NOP                 ; Stall 1 machine cycle
        LDI 0x2             ; Load 0x02 in A
        MOV D, A            ; Point D to Destination Adderess 
        LD                  ; Load Destination Address to MBR
        MOV SY, MBR         ; Store Desitnation Address in SY
        INCR D              ; Point D to Length
        LD                  ; Load Length to MBR
        MOV Y, MBR          ; Store Length to Y
        INCR D              ; Point D to Soure Address
        MOV SX, D           ; Store Source Address to SX
        CLR X               ; Clear X as Counter
        LDI 0x01            ; Load 0x02 to A
        MOV SD, A           ; Point SD to &loop

loop:   MOV D, SX           ; Source Pointer to D
        LD                  ; Load the element to MBR
        INCR D              ; Next Pointer
        MOV SX, D           ; Store D to SX
        MOV D, SY           ; Point D to Destination Address
        ST                  ; Store MBR to [D]
        INCR D              ; Next Pointer
        MOV SY, D           ; Store D to SY
        MOV D, SD           ; Point D to loop
        DECR Y              ; Decrement counter
        BNZ D               ; Goto Loop if Y != 0
        
        HALT

.nmi
; NMI Handler
        CLR D              ; Clear D to point at main
        BRZ                ; Loop to address in D &main

.irq
; Interrupt Service Routine
        CLR D              ; Clear D to point at main
        BRZ                ; Loop to address in D &main